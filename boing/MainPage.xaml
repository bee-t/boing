<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="boing.MainPage"
             Title="Boing Kids"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
        <AbsoluteLayout x:Name="BackgroundLayer" HorizontalOptions="Fill" VerticalOptions="Fill">
            <BoxView x:Name="BgBlob1" Color="#4ECDC4" Opacity="0.45" 
                     CornerRadius="200" WidthRequest="380" HeightRequest="380"
                     AbsoluteLayout.LayoutBounds="0.1, 0.05, 380, 380" AbsoluteLayout.LayoutFlags="None" />
            <BoxView x:Name="BgBlob2" Color="#AA96DA" Opacity="0.42" 
                     CornerRadius="180" WidthRequest="320" HeightRequest="320"
                     AbsoluteLayout.LayoutBounds="0.6, 0.15, 320, 320" AbsoluteLayout.LayoutFlags="None" />
            <BoxView x:Name="BgBlob3" Color="#FFE66D" Opacity="0.4" 
                     CornerRadius="160" WidthRequest="280" HeightRequest="280"
                     AbsoluteLayout.LayoutBounds="0.2, 0.55, 280, 280" AbsoluteLayout.LayoutFlags="None" />
            <BoxView x:Name="BgBlob4" Color="#F8B4D9" Opacity="0.38" 
                     CornerRadius="140" WidthRequest="240" HeightRequest="240"
                     AbsoluteLayout.LayoutBounds="0.55, 0.7, 240, 240" AbsoluteLayout.LayoutFlags="None" />
            <BoxView x:Name="BgBlob5" Color="#FF6B6B" Opacity="0.35" 
                     CornerRadius="120" WidthRequest="220" HeightRequest="220"
                     AbsoluteLayout.LayoutBounds="0.75, 0.35, 220, 220" AbsoluteLayout.LayoutFlags="None" />
        </AbsoluteLayout>

        <ScrollView>
            <VerticalStackLayout Padding="28" Spacing="24" VerticalOptions="Center" HorizontalOptions="Center">
                <Frame x:Name="HeroFrame" CornerRadius="28" HasShadow="True" Padding="0" 
                       BackgroundColor="{AppThemeBinding Light={StaticResource HeroCardBackgroundLight}, Dark={StaticResource HeroCardBackgroundDark}}"
                       BorderColor="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
                       Margin="0,40,0,0" Opacity="0.95">
                    <Frame.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowBrushLightBrush}, Dark={StaticResource ShadowBrushDarkBrush}}" Offset="0,8" Radius="24" Opacity="0.15"/>
                    </Frame.Shadow>
                    <VerticalStackLayout Spacing="12" Padding="32,28">
                        <Label Text="🌈 Boing Kids" FontSize="34" FontAttributes="Bold" 
                               HorizontalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        <Label Text="Learn &amp; play with fun games" FontSize="16" 
                               HorizontalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" Opacity="0.9" />
                    </VerticalStackLayout>
                </Frame>

                <Image Source="dotnet_bot.png" HeightRequest="140" Aspect="AspectFit" 
                       x:Name="MascotImage" />

                <Button x:Name="PlayGamesBtn" Text="▶  Play Games" 
                        Clicked="OnPlayGamesClicked" 
                        WidthRequest="280" HeightRequest="58" 
                        FontSize="18" FontAttributes="Bold"
                        CornerRadius="24"
                        TextColor="White"
                        Margin="0,8,0,0">
                    <Button.Shadow>
                        <Shadow Brush="#80512BD4" Offset="0,6" Radius="14" Opacity="0.4"/>
                    </Button.Shadow>
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6B4CE0" Offset="0"/>
                            <GradientStop Color="#512BD4" Offset="0.5"/>
                            <GradientStop Color="#4520B8" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

                <Label Text="Pick a game and have fun!" FontSize="13" HorizontalOptions="Center" 
                       TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" Opacity="0.85" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
