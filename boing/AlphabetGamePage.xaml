<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="boing.AlphabetGamePage"
             Title="Alphabet Fun"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
        <AbsoluteLayout HorizontalOptions="Fill" VerticalOptions="Fill">
            <BoxView x:Name="GameBg1" Color="#AA96DA" Opacity="0.45" 
                     CornerRadius="150" WidthRequest="300" HeightRequest="300"
                     AbsoluteLayout.LayoutBounds="0.65, -0.05, 300, 300" AbsoluteLayout.LayoutFlags="None" />
            <BoxView x:Name="GameBg2" Color="#4ECDC4" Opacity="0.4" 
                     CornerRadius="120" WidthRequest="250" HeightRequest="250"
                     AbsoluteLayout.LayoutBounds="-0.05, 0.42, 250, 250" AbsoluteLayout.LayoutFlags="None" />
            <BoxView x:Name="GameBg3" Color="#FFE66D" Opacity="0.35" 
                     CornerRadius="100" WidthRequest="200" HeightRequest="200"
                     AbsoluteLayout.LayoutBounds="0.08, 0.78, 200, 200" AbsoluteLayout.LayoutFlags="None" />
            <BoxView x:Name="GameBg4" Color="#FF6B6B" Opacity="0.3" 
                     CornerRadius="80" WidthRequest="170" HeightRequest="170"
                     AbsoluteLayout.LayoutBounds="0.78, 0.38, 170, 170" AbsoluteLayout.LayoutFlags="None" />
        </AbsoluteLayout>

        <VerticalStackLayout Padding="24" Spacing="20">
            <Button x:Name="BackBtn" Text="← Back" Clicked="OnBackClicked" 
                    HorizontalOptions="Start" BackgroundColor="Transparent" 
                    TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                    FontSize="17" FontAttributes="Bold" />

            <Label Text="Find the letter:" FontSize="20" 
                   TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                   HorizontalOptions="Center" Margin="0,8,0,0" />

            <Frame x:Name="LetterFrame" CornerRadius="24" HasShadow="True" 
                   Padding="24" WidthRequest="120" HeightRequest="120"
                   HorizontalOptions="Center"
                   BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                   BorderColor="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}">
                <Frame.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowBrushLightBrush}, Dark={StaticResource ShadowBrushDarkBrush}}" Offset="0,4" Radius="12" Opacity="0.12"/>
                </Frame.Shadow>
                <Label x:Name="LetterLabel" Text="A" FontSize="56" FontAttributes="Bold" 
                       HorizontalOptions="Center" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
            </Frame>

            <Label Text="Tap the matching letter below" FontSize="14" 
                   TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                   HorizontalOptions="Center" />

            <Grid x:Name="ChoicesGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" 
                  ColumnSpacing="16" RowSpacing="16" Margin="0,16,0,0">
                <Frame x:Name="Choice0" Grid.Row="0" Grid.Column="0" Padding="20" CornerRadius="20" 
                       HasShadow="True"
                       BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                       BorderColor="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}">
                    <Frame.Shadow><Shadow Brush="{AppThemeBinding Light={StaticResource ShadowBrushLightBrush}, Dark={StaticResource ShadowBrushDarkBrush}}" Offset="0,4" Radius="10" Opacity="0.1"/></Frame.Shadow>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnChoiceTapped" />
                    </Frame.GestureRecognizers>
                    <Label x:Name="Choice0Label" Text="?" FontSize="32" FontAttributes="Bold" 
                           HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                </Frame>
                <Frame x:Name="Choice1" Grid.Row="0" Grid.Column="1" Padding="20" CornerRadius="20" 
                       HasShadow="True"
                       BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                       BorderColor="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}">
                    <Frame.Shadow><Shadow Brush="{AppThemeBinding Light={StaticResource ShadowBrushLightBrush}, Dark={StaticResource ShadowBrushDarkBrush}}" Offset="0,4" Radius="10" Opacity="0.1"/></Frame.Shadow>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnChoiceTapped" />
                    </Frame.GestureRecognizers>
                    <Label x:Name="Choice1Label" Text="?" FontSize="32" FontAttributes="Bold" 
                           HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                </Frame>
                <Frame x:Name="Choice2" Grid.Row="1" Grid.Column="0" Padding="20" CornerRadius="20" 
                       HasShadow="True"
                       BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                       BorderColor="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}">
                    <Frame.Shadow><Shadow Brush="{AppThemeBinding Light={StaticResource ShadowBrushLightBrush}, Dark={StaticResource ShadowBrushDarkBrush}}" Offset="0,4" Radius="10" Opacity="0.1"/></Frame.Shadow>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnChoiceTapped" />
                    </Frame.GestureRecognizers>
                    <Label x:Name="Choice2Label" Text="?" FontSize="32" FontAttributes="Bold" 
                           HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                </Frame>
                <Frame x:Name="Choice3" Grid.Row="1" Grid.Column="1" Padding="20" CornerRadius="20" 
                       HasShadow="True"
                       BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                       BorderColor="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}">
                    <Frame.Shadow><Shadow Brush="{AppThemeBinding Light={StaticResource ShadowBrushLightBrush}, Dark={StaticResource ShadowBrushDarkBrush}}" Offset="0,4" Radius="10" Opacity="0.1"/></Frame.Shadow>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnChoiceTapped" />
                    </Frame.GestureRecognizers>
                    <Label x:Name="Choice3Label" Text="?" FontSize="32" FontAttributes="Bold" 
                           HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                </Frame>
            </Grid>

            <Label x:Name="ScoreLabel" Text="Score: 0" FontSize="16" 
                   TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                   HorizontalOptions="Center" Margin="0,20,0,0" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
